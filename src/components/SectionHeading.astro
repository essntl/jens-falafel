---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="text-center mb-10">
  <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-2">{title}</h2>
  {subtitle && <p class="text-gray-500 text-lg">{subtitle}</p>}
  <div class="w-16 h-1 bg-primary mx-auto mt-4 rounded"></div>
</div>
