---
import logo from '../assets/logo.png';
import { Image } from 'astro:assets';


const links = [
  { href: '/', label: 'Hjem' },
  { href: '/meny', label: 'Meny' },
  { href: '/om-oss', label: 'Om oss' },
  { href: '/gjestebok', label: 'Gjestebok' },
  { href: '/kontakt', label: 'Kontakt' },
];

const currentPath = Astro.url.pathname;
---

<nav class="bg-secondary text-white shadow-lg">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex items-center justify-between h-24">
      <a href="/" class="flex items-center gap-2 text-xl font-bold tracking-tight">
        <Image src={logo} alt="Jens Falafel logo" class="md:h-24 md:w-24 h-16 w-16" loading="eager" />
      </a>

      <button
        id="menu-toggle"
        class="md:hidden p-2 rounded hover:bg-white/10 transition-colors"
        aria-label="Toggle meny"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <ul class="hidden md:flex items-center gap-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'px-4 py-2 rounded text-sm font-medium transition-colors',
                currentPath === link.href
                  ? 'text-white'
                  : 'text-gray-300 hover:bg-white/10 hover:text-white',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <ul id="mobile-menu" class="hidden md:hidden pb-4 space-y-1">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block px-4 py-2 rounded text-sm font-medium transition-colors',
              currentPath === link.href
                ? 'bg-primary text-white'
                : 'text-gray-300 hover:bg-white/10 hover:text-white',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
