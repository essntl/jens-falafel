---
import logo from '../assets/logo.png';
import { Image } from 'astro:assets';

const year = new Date().getFullYear();
---

<footer class="bg-secondary text-gray-400 text-sm">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-white font-bold text-lg mb-2">
          <Image src={logo} alt="Jens Falafel logo" class="md:h-24 md:w-24 h-16 w-16" />
        </h3>
        <p>Oslos beste falafel siden 2000.</p>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-2">Åpningstider</h4>
        <p>Mandag - Søndag: 11:00 - 22:00</p>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-2">Adresse</h4>
        <p>Falafelgata 1, Oslo</p>
        <p>Telefon: 700 00 000</p>
      </div>
    </div>

    <div class="border-t border-gray-700 mt-8 pt-6 text-center text-gray-500">
      <p>&copy; {year} Jens Falafel. Alle rettigheter reservert.</p>
    </div>
  </div>
</footer>
