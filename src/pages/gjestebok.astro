---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const initialEntries = [
  {
    name: 'John',
    date: '12.02.2003',
    message: 'Anbefales',
  },
  {
    name: 'Liv',
    date: '03.01.2003',
    message: 'Beste falafel i verden',
  },
];
---

<Layout title="Gjestebok - Jens Falafel" description="Skriv en hilsen i gjesteboken vår.">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <SectionHeading
      title="Gjestebok"
      subtitle="Skriv en hilsen til oss"
    />

    <div class="bg-white rounded-lg shadow-md border border-gray-100 p-6 mb-10">
      <form id="guestbook-form" class="space-y-4">
        <div>
          <label for="guest-name" class="block text-sm font-medium text-secondary mb-1">
            Navn
          </label>
          <input
            type="text"
            id="guest-name"
            placeholder="Navnet ditt"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
          />
        </div>
        <div>
          <label for="guest-message" class="block text-sm font-medium text-secondary mb-1">
            Melding
          </label>
          <textarea
            id="guest-message"
            rows="3"
            placeholder="Skriv meldingen din her"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent resize-none"
          ></textarea>
        </div>
        <button
          type="submit"
          class="bg-primary hover:bg-primary-dark text-white font-semibold px-6 py-2 rounded-lg transition-colors"
        >
          Send inn
        </button>
      </form>
    </div>

    <div id="entries" class="space-y-4">
      {initialEntries.map((entry) => (
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5">
          <div class="flex items-center justify-between mb-2">
            <span class="font-semibold text-secondary">{entry.name}</span>
            <span class="text-sm text-gray-400">{entry.date}</span>
          </div>
          <p class="text-gray-600">{entry.message}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>

</script>
